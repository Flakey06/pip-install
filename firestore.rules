rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function groupExists(groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId));
    }

    function isGroupMember(groupId) {
      return signedIn()
        && groupExists(groupId)
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
    }

    function isGroupAdmin(groupId) {
      return signedIn()
        && groupExists(groupId)
        && get(/databases/$(database)/documents/groups/$(groupId)).data.adminId == request.auth.uid;
    }

    function userUpdateFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "username", "displayName", "photoURL", "major", "year", "bio", "telegram",
        "interests", "groups", "openInviteGroups", "updatedAt", "onboardingDone",
        "fcmToken", "nusVerified", "nusEmail", "nusVerifiedAt"
      ]);
    }

    function userCreateFields() {
      return request.resource.data.keys().hasOnly([
        "uid", "email", "username", "displayName", "photoURL", "major", "year",
        "bio", "telegram", "interests", "groups", "openInviteGroups", "createdAt"
      ]);
    }

    function nusVerification() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          "nusVerified", "nusEmail", "nusVerifiedAt"
        ])
        || (
          request.resource.data.nusVerified == true
          && request.resource.data.nusEmail == request.auth.token.email
          && request.auth.token.email.matches(".*@u\\.nus\\.edu$")
        );
    }

    function groupShape() {
      return request.resource.data.members is list
        && request.resource.data.members.size() <= 6;
    }

    function groupCreateFields() {
      return request.resource.data.keys().hasOnly([
        "name", "members", "memberCount", "sharedInterests", "adminId", "type",
        "createdAt", "historyForAll", "memberJoinedAt", "photoURL"
      ]);
    }

    function groupJoinFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "members", "memberCount", "memberJoinedAt", "historyForAll",
        "sharedInterests", "name"
      ]);
    }

    function groupAdminFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "name", "photoURL", "historyForAll", "adminId", "sharedInterests"
      ]);
    }

    function noChangeInAdmin() {
      return !("adminId" in resource.data)
        || request.resource.data.adminId == resource.data.adminId;
    }

    function JoiningGroup() {
      return !(request.auth.uid in resource.data.members)
        && request.auth.uid in request.resource.data.members;
    }

    function LeavingGroup() {
      return request.auth.uid in resource.data.members
        && !(request.auth.uid in request.resource.data.members);
    }

    function requestForFriendship(requestId) {
      return exists(/databases/$(database)/documents/friendRequests/$(requestId))
        && get(/databases/$(database)/documents/friendRequests/$(requestId)).data.status in ["pending", "accepted"];
    }

    function friendDoc(friendDocId) {
      return request.resource.data.keys().hasOnly(["uid", "addedAt"])
        && request.resource.data.uid is string
        && (
          (
            friendDocId == request.auth.uid + "_" + request.resource.data.uid
            && requestForFriendship(request.resource.data.uid + "_" + request.auth.uid)
          )
          ||
          (
            requestForFriendship(friendDocId)
            && get(/databases/$(database)/documents/friendRequests/$(friendDocId)).data.toUid == request.auth.uid
            && request.resource.data.uid == request.auth.uid
          )
        );
    }

    match /users/{userId} {
      allow read: if signedIn();

      allow create: if isSelf(userId)
        && request.resource.data.uid == request.auth.uid
        && userCreateFields();

      allow update: if isSelf(userId)
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && userUpdateFields()
        && nusVerification();

      allow delete: if isSelf(userId);
    }

    match /interests/{docId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && docId == "master"
        && request.resource.data.keys().hasOnly(["list"])
        && request.resource.data.list is list;

      allow update: if signedIn()
        && docId == "master"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["list"])
        && request.resource.data.list is list;

      allow delete: if false;

      match /items/{interestId} {
        allow read: if signedIn();

        allow create: if signedIn()
          && request.resource.data.keys().hasOnly([
            "interest", "categories", "scores", "source", "updatedAt"
          ])
          && request.resource.data.interest is string
          && request.resource.data.categories is list
          && request.resource.data.scores is map
          && request.resource.data.source == "tfjs_numeric_model";

        allow update: if signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "interest", "categories", "scores", "source", "updatedAt"
          ])
          && request.resource.data.interest is string
          && request.resource.data.categories is list
          && request.resource.data.scores is map
          && request.resource.data.source == "tfjs_numeric_model"
          && request.resource.data.interest == resource.data.interest;

        allow delete: if false;
      }
    }

    match /groups/{groupId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && groupCreateFields()
        && groupShape()
        && request.resource.data.members is list
        && request.resource.data.members.size() == 1
        && request.resource.data.members[0] == request.auth.uid
        && (
          !("adminId" in request.resource.data)
          || request.resource.data.adminId == request.auth.uid
        );

      allow update: if signedIn() && groupShape()
        && (
          (
            isGroupAdmin(groupId)
            && groupAdminFields()
          )
          ||
          (
            JoiningGroup()
            && groupJoinFields()
            && noChangeInAdmin()
          )
          ||
          (
            LeavingGroup()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "members", "memberCount", "adminId"
            ])
          )
        );

      allow delete: if isGroupAdmin(groupId);
    }

    match /lastSeen/{lastSeenId} {
      allow read: if signedIn()
        && resource.data.uid == request.auth.uid;

      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid;

      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid;
    }

    match /friends/{friendDocId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && friendDoc(friendDocId);

      allow update: if false;

      allow delete: if signedIn()
        && (
          friendDocId == request.auth.uid + "_" + resource.data.uid ||
          resource.data.uid == request.auth.uid
        );
    }

    match /friendRequests/{requestId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && requestId == request.auth.uid + "_" + request.resource.data.toUid
        && request.resource.data.keys().hasOnly(["fromUid", "toUid", "status", "createdAt"])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == "pending";

      allow update: if signedIn()
        && resource.data.toUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
        && resource.data.status == "pending"
        && request.resource.data.status in ["accepted", "declined"];

      allow delete: if signedIn()
        && (
          resource.data.fromUid == request.auth.uid ||
          resource.data.toUid == request.auth.uid
        );
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == "pending";

      allow read, update, delete: if false;
    }

    match /blocks/{blockId} {
      allow get: if signedIn()
        && blockId.matches(request.auth.uid + "_.*");

      allow list: if signedIn()
        && resource.data.blockerUid == request.auth.uid;

      allow create: if signedIn()
        && blockId == request.auth.uid + "_" + request.resource.data.blockedUid
        && request.resource.data.keys().hasOnly(["blockerUid", "blockedUid", "createdAt"])
        && request.resource.data.blockerUid == request.auth.uid
        && request.resource.data.blockedUid is string
        && request.resource.data.blockedUid != request.auth.uid;

      allow update: if false;

      allow delete: if signedIn()
        && resource.data.blockerUid == request.auth.uid;
    }

    match /profileViews/{viewId} {
      allow read: if signedIn();

      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(["viewerUid", "viewedUid", "viewedAt"])
        && request.resource.data.viewerUid == request.auth.uid
        && request.resource.data.viewedUid is string
        && request.resource.data.viewedUid != request.auth.uid;

      allow delete: if false;
    }

    match /openInvites/{inviteId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.attendees is list
        && request.auth.uid in request.resource.data.attendees
        && request.resource.data.keys().hasOnly([
          "title", "details", "location", "when", "createdBy", "createdByName",
          "createdAt", "attendees", "groupId"
        ]);

      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["attendees"])
        && request.resource.data.attendees is list
        && request.auth.uid in request.resource.data.attendees;

      allow delete: if signedIn()
        && resource.data.createdBy == request.auth.uid;
    }

    match /nusVerifyCodes/{userId} {
      allow read, create, update, delete: if isSelf(userId);
    }

    match /groupEvents/{eventId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "groupId", "title", "date", "time", "location", "note", "createdBy", "createdAt"
        ])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.groupId is string
        && request.resource.data.title is string
        && request.resource.data.date is string;

      allow update, delete: if signedIn()
        && resource.data.createdBy == request.auth.uid;
    }

    match /personalEvents/{eventId} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "userId", "title", "date", "time", "location", "note", "groupId", "createdAt"
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.date is string;

      allow update, delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }
  }
}
